{
  "name": "citroen-zx-kitcar-sim",
  "version": "6.0.0",
  "description": "Citroen ZX Kit Car Rally Simulator v6.0 with Push-Start - HTML5/Canvas port for Android",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "cordova:prepare": "cordova prepare android",
    "cordova:build": "cordova build android --release",
    "cordova:run": "cordova run android"
  },
  "keywords": [
    "citroen",
    "zx",
    "kitcar",
    "rally",
    "simulator",
    "racing",
    "android",
    "cordova"
  ],
  "author": "Ported from citroen_ZX_16V.cpp (C++/Windows original)",
  "license": "MIT",
  "engines": {
    "node": ">=5.8.0"
  },
  "devDependencies": {
    "cordova": "^8.1.2"
  },
  "cordova": {
    "platforms": [
      "android@~8.1.0"
    ],
    "plugins": [
      "cordova-plugin-whitelist",
      "cordova-plugin-statusbar"
    ]
  }
}
