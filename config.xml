<?xml version='1.0' encoding='utf-8'?>
<widget id="com.zxkitcar.sim" version="6.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>ZX KitCar Sim</name>
    <description>
        Citroen ZX Kit Car Rally Simulator v6.0 with Push-Start/Bump-Start.
        Full vehicle physics simulation on a 256x256 canvas.
    </description>
    <author email="sim@zxkitcar.local" href="https://github.com/">
        Citroen ZX Kit Car Sim Team
    </author>

    <!-- Android 4.4.4 compatibility: API 19+ -->
    <preference name="android-minSdkVersion" value="19" />
    <preference name="android-targetSdkVersion" value="28" />
    <preference name="android-compileSdkVersion" value="28" />

    <!-- WebView settings for Android 4.4.4+ -->
    <preference name="WebViewbounce" value="false" />
    <preference name="DisallowOverscroll" value="true" />
    <preference name="HideKeyboardFormAccessoryBar" value="true" />
    <preference name="KeyboardDisplayRequiresUserAction" value="false" />
    <preference name="SplashScreen" value="none" />
    <preference name="SplashScreenDelay" value="0" />
    <preference name="FadeSplashScreen" value="false" />
    <preference name="StatusBarOverlaysWebView" value="false" />
    <preference name="StatusBarBackgroundColor" value="#1a1a1a" />
    <preference name="StatusBarStyle" value="lightcontent" />

    <!-- Keep screen on during gameplay -->
    <preference name="KeepRunning" value="true" />
    <preference name="AndroidPersistentFileLocation" value="Compatibility" />

    <!-- Content source -->
    <content src="index.html" />

    <!-- Access rules -->
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />

    <!-- Platform -->
    <platform name="android">
        <preference name="android-minSdkVersion" value="19" />
        <preference name="android-targetSdkVersion" value="28" />
        <icon density="ldpi" src="res/icon/android/ldpi.png" />
        <icon density="mdpi" src="res/icon/android/mdpi.png" />
        <icon density="hdpi" src="res/icon/android/hdpi.png" />
        <icon density="xhdpi" src="res/icon/android/xhdpi.png" />
        <icon density="xxhdpi" src="res/icon/android/xxhdpi.png" />
        <splash density="mdpi" src="res/screen/android/splash-mdpi.png" />
        <splash density="hdpi" src="res/screen/android/splash-hdpi.png" />
        <splash density="xhdpi" src="res/screen/android/splash-xhdpi.png" />
        <splash density="xxhdpi" src="res/screen/android/splash-xxhdpi.png" />
    </platform>

    <!-- Plugins -->
    <plugin name="cordova-plugin-whitelist" spec="1.3.4" />
    <plugin name="cordova-plugin-statusbar" spec="2.4.3" />
</widget>
