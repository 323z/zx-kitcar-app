<?xml version="1.0" encoding="UTF-8"?>
<widget id="com.zxkitcar.sim"
        version="6.0.0"
        xmlns="http://www.w3.org/ns/widgets"
        xmlns:cdv="http://cordova.apache.org/ns/1.0">

    <name>Citroen ZX Rally</name>
    <description>
        Citroen ZX Kit Car Rally Simulator v6.0
        256x256 pixel racing simulation with full telemetry,
        6-speed sequential gearbox, push-start, and overboost.
    </description>
    <author email="dev@zxkitcar.local" href="https://example.com">
        ZX Kit Car Dev Team
    </author>

    <!-- Android 4.4.4 = API 19; target API 28 (Android 9) -->
    <preference name="android-minSdkVersion"   value="19" />
    <preference name="android-targetSdkVersion" value="28" />
    <preference name="android-compileSdkVersion" value="28" />
    <preference name="android-build-tools"      value="28.0.3" />

    <!-- App behavior -->
    <preference name="Fullscreen"               value="true" />
    <preference name="Orientation"              value="landscape" />
    <preference name="StatusBarOverlaysWebView" value="false" />
    <preference name="StatusBarBackgroundColor"  value="#000000" />
    <preference name="KeepRunning"              value="true" />
    <preference name="DisallowOverscroll"       value="true" />
    <preference name="HideKeyboardFormAccessoryBar" value="true" />

    <!-- WebView settings for Canvas performance -->
    <preference name="AndroidPersistentFileLocation" value="Compatibility" />
    <preference name="AppendUserAgent"                value="ZXKitCarSim/6.0" />

    <!-- Content source -->
    <content src="index.html" />

    <!-- Whitelist -->
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-navigation href="*" />

    <!-- Android platform -->
    <platform name="android">
        <preference name="android-minSdkVersion"   value="19" />
        <preference name="android-targetSdkVersion" value="28" />

        <!-- Icons -->
        <icon src="res/icon/android/ldpi.png"  density="ldpi"  />
        <icon src="res/icon/android/mdpi.png"  density="mdpi"  />
        <icon src="res/icon/android/hdpi.png"  density="hdpi"  />
        <icon src="res/icon/android/xhdpi.png" density="xhdpi" />
        <icon src="res/icon/android/xxhdpi.png" density="xxhdpi" />

        <!-- Splash screens -->
        <splash src="res/screen/android/splash-mdpi.png"   density="mdpi"  />
        <splash src="res/screen/android/splash-hdpi.png"   density="hdpi"  />
        <splash src="res/screen/android/splash-xhdpi.png"  density="xhdpi" />
        <splash src="res/screen/android/splash-xxhdpi.png" density="xxhdpi" />

        <!-- Permissions -->
        <config-file target="AndroidManifest.xml" parent="/*">
            <uses-permission android:name="android.permission.INTERNET" />
            <uses-permission android:name="android.permission.VIBRATE" />
        </config-file>

        <!-- Keep hardware acceleration on for Canvas -->
        <config-file target="AndroidManifest.xml" parent="application">
            <activity android:hardwareAccelerated="true" />
        </config-file>
    </platform>

    <!-- Plugins -->
    <plugin name="cordova-plugin-whitelist" spec="1.3.4" />
    <plugin name="cordova-plugin-statusbar" spec="2.4.3" />

</widget>
