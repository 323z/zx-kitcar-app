<?xml version='1.0' encoding='utf-8'?>
<widget id="com.zxkitcar.sim" version="6.0.0"
        xmlns="http://www.w3.org/ns/widgets"
        xmlns:android="http://schemas.android.com/apk/res/android">

    <name>Citroen ZX Kit Car Sim</name>
    <description>Citroen ZX Kit Car Rally Simulator v6.0 — 256x256 racing game</description>
    <author email="dev@zxkitcar.local" href="https://github.com">ZX Dev Team</author>

    <content src="index.html"/>
    <access origin="*"/>
    <allow-intent href="http://*/*"/>
    <allow-intent href="https://*/*"/>

    <!-- Android preferences -->
    <preference name="android-minSdkVersion" value="19"/>
    <preference name="android-targetSdkVersion" value="28"/>
    <preference name="android-compileSdkVersion" value="28"/>
    <preference name="android-build-tools-version" value="28.0.3"/>
    <preference name="android-gradleVersion" value="4.10.3"/>
    <preference name="android-cordovaGradlePluginsVersion" value="1.0.0"/>

    <!-- App settings -->
    <preference name="Fullscreen" value="true"/>
    <preference name="Orientation" value="portrait"/>
    <preference name="KeepRunning" value="true"/>
    <preference name="DisallowOverscroll" value="true"/>
    <preference name="HideKeyboardFormAccessoryBar" value="true"/>
    <preference name="StatusBarOverlaysWebView" value="false"/>
    <preference name="StatusBarBackgroundColor" value="#000000"/>

    <platform name="android">
        <!-- Gradle settings for Cordova-Android 8.1.0 -->
        <preference name="GradleVersion" value="4.10.3"/>
        <preference name="AndroidGradlePluginVersion" value="3.3.0"/>

        <!-- Icons (generated by CI pipeline) -->
        <icon src="res/icon/android/ldpi.png"   density="ldpi"/>
        <icon src="res/icon/android/mdpi.png"   density="mdpi"/>
        <icon src="res/icon/android/hdpi.png"   density="hdpi"/>
        <icon src="res/icon/android/xhdpi.png"  density="xhdpi"/>
        <icon src="res/icon/android/xxhdpi.png" density="xxhdpi"/>

        <!-- Splash screens -->
        <splash src="res/screen/android/splash-mdpi.png"   density="mdpi"/>
        <splash src="res/screen/android/splash-hdpi.png"   density="hdpi"/>
        <splash src="res/screen/android/splash-xhdpi.png"  density="xhdpi"/>
        <splash src="res/screen/android/splash-xxhdpi.png" density="xxhdpi"/>
    </platform>

</widget>
