<?xml version='1.0' encoding='utf-8'?>
<widget id="com.zxkitcar.sim" version="6.0.0" xmlns="http://www.w3.org/ns/widgets">
    <name>Citroen ZX Sim</name>
    <description>Citroen ZX Kit Car Rally Simulator v6.0</description>
    <author email="dev@zxkitcar.local">ZX Dev Team</author>
    <content src="index.html"/>
    <access origin="*"/>
    <allow-intent href="http://*/*"/>
    <allow-intent href="https://*/*"/>
    <preference name="android-minSdkVersion" value="19"/>
    <preference name="android-targetSdkVersion" value="28"/>
    <preference name="android-compileSdkVersion" value="28"/>
    <preference name="android-buildToolsVersion" value="28.0.3"/>
    <preference name="BackgroundColor" value="0x1a1a2e"/>
    <preference name="StatusBarOverlaysWebView" value="false"/>
    <preference name="StatusBarBackgroundColor" value="#1a1a2e"/>
    <preference name="Fullscreen" value="true"/>
    <platform name="android">
        <preference name="android-minSdkVersion" value="19"/>
        <preference name="android-targetSdkVersion" value="28"/>
    </platform>
</widget>
